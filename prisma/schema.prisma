generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TimeHorizon {
  day_trade
  swing_trade
  long_term
}

enum RiskLevel {
  low
  medium
  high
}

model User {
  id            String             @id @default(cuid())
  email         String             @unique
  createdAt     DateTime           @default(now())
  watchlists    Watchlist[]
  analyses      AiAnalysis[]
  alerts        Alert[]
  sectorWatches SectorWatch[]
  dailyBriefs   DailyMarketBrief[]
  analysisJobs  AnalysisJob[]
  aiUsageLogs   AiUsageLog[]
  userMemory    UserMemory?
  focusGroup    FocusGroup?
  focusDecisions FocusDecision[]
  analysisRuns  AnalysisRun[]
  decisionHistories DecisionHistory[]
}

model Watchlist {
  id        String          @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime        @default(now())
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WatchlistItem[]

  @@index([userId])
}

model WatchlistItem {
  id           String      @id @default(cuid())
  watchlistId  String
  symbol       String
  market       String      @default("US")
  note         String?
  holdingPrice Decimal?    @db.Decimal(18, 4)
  isHolding    Boolean     @default(false)
  targetPrice  Decimal?    @db.Decimal(18, 4)
  stopLoss     Decimal?    @db.Decimal(18, 4)
  positionOpenedAt DateTime?
  timeHorizon  TimeHorizon @default(swing_trade)
  riskLevel    RiskLevel   @default(medium)
  createdAt    DateTime    @default(now())
  watchlist    Watchlist   @relation(fields: [watchlistId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, symbol])
  @@index([symbol])
}

model PriceSnapshot {
  id        String   @id @default(cuid())
  symbol    String
  open      Decimal  @db.Decimal(18, 4)
  high      Decimal  @db.Decimal(18, 4)
  low       Decimal  @db.Decimal(18, 4)
  close     Decimal  @db.Decimal(18, 4)
  price     Decimal  @db.Decimal(18, 4)
  volume    BigInt
  timestamp DateTime

  @@index([symbol, timestamp])
}

model TechnicalIndicator {
  id              String   @id @default(cuid())
  symbol          String
  rsi14           Decimal? @db.Decimal(18, 6)
  macd            Decimal? @db.Decimal(18, 6)
  macdSignal      Decimal? @db.Decimal(18, 6)
  sma20           Decimal? @db.Decimal(18, 6)
  sma50           Decimal? @db.Decimal(18, 6)
  sma200          Decimal? @db.Decimal(18, 6)
  ema20           Decimal? @db.Decimal(18, 6)
  bollingerUpper  Decimal? @db.Decimal(18, 6)
  bollingerMiddle Decimal? @db.Decimal(18, 6)
  bollingerLower  Decimal? @db.Decimal(18, 6)
  timestamp       DateTime

  @@index([symbol, timestamp])
}

model AiAnalysis {
  id         String   @id @default(cuid())
  userId     String
  symbol     String
  inputJson  Json
  outputJson Json
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, symbol, createdAt])
}

model Alert {
  id          String    @id @default(cuid())
  userId      String
  symbol      String
  alertType   String
  operator    String
  threshold   Decimal   @db.Decimal(18, 6)
  isActive    Boolean   @default(true)
  triggeredAt DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, symbol])
}

model NewsItem {
  id          String         @id @default(cuid())
  title       String
  titleHash   String         @unique
  url         String?        @unique
  source      String?
  publishedAt DateTime
  rawContent  String?
  summary     String?
  symbols     String[]
  sectors     String[]
  sentiment   String?
  importance  String?
  createdAt   DateTime       @default(now())
  analyses    NewsAnalysis[]

  @@index([publishedAt])
  @@index([symbols])
  @@index([sectors])
}

model NewsAnalysis {
  id              String   @id @default(cuid())
  newsItemId      String
  aiSummary       String
  sentiment       String
  affectedSymbols String[]
  affectedSectors String[]
  impactLevel     String
  riskNotes       String[]
  whyItMatters    String?
  confidence      Decimal? @db.Decimal(5, 4)
  createdAt       DateTime @default(now())
  newsItem        NewsItem @relation(fields: [newsItemId], references: [id], onDelete: Cascade)

  @@index([newsItemId, createdAt])
}

model SectorWatch {
  id         String   @id @default(cuid())
  userId     String
  sectorName String
  keywords   String[]
  symbols    String[]
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DailyMarketBrief {
  id               String   @id @default(cuid())
  userId           String
  date             DateTime
  watchlistSummary String
  sectorSummary    String
  riskSummary      String
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

model CacheEntry {
  key       String   @id
  value     Json
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

model AnalysisJob {
  id           String    @id @default(cuid())
  userId       String
  symbol       String?
  jobType      String
  status       String    @default("queued")
  priority     Int       @default(30)
  inputHash    String?
  attempts     Int       @default(0)
  maxAttempts  Int       @default(2)
  resultId     String?
  errorMessage String?
  lockedAt     DateTime?
  lockedBy     String?
  payload      Json?
  createdAt    DateTime  @default(now())
  startedAt    DateTime?
  completedAt  DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, priority, createdAt])
  @@index([symbol, jobType])
  @@index([inputHash])
}

model AiUsageLog {
  id               String   @id @default(cuid())
  userId           String
  symbol           String?
  jobType          String
  provider         String
  model            String
  inputHash        String?
  promptTokens     Int?
  completionTokens Int?
  estimatedCost    Decimal? @db.Decimal(18, 8)
  cacheHit         Boolean  @default(false)
  reason           String
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, symbol, createdAt])
  @@index([inputHash])
}

model AiConfig {
  id        String   @id @default(cuid())
  apiKey    String   @default("")
  baseUrl   String   @default("https://api.deepseek.com")
  model     String   @default("deepseek-v4-pro")
  updatedAt DateTime @updatedAt
}

model UserMemory {
  userId    String   @id
  content   String   @default("")
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FocusGroup {
  id            String   @id @default(cuid())
  userId        String   @unique
  name          String   @default("今日关注")
  symbols       String[]
  capital       Decimal? @db.Decimal(18, 2)
  newsFetchTime String   @default("09:30")
  analysisTimes String[] @default([])
  lastNewsFetch DateTime?
  lastAnalysis  DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FocusDecision {
  id           String   @id @default(cuid())
  userId       String
  inputHash    String
  source       String   @default("manual")
  scheduledFor DateTime?
  decisionJson Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, inputHash, source])
  @@index([userId, createdAt])
}

model AnalysisRun {
  id              String   @id @default(cuid())
  userId          String
  runType         String
  status          String   @default("running")
  startedAt       DateTime @default(now())
  finishedAt      DateTime?
  durationMs      Int?
  totalSymbols    Int      @default(0)
  successCount    Int      @default(0)
  failedCount     Int      @default(0)
  nextRunAt       DateTime?
  fallbackUsed    Boolean  @default(false)
  errorSummary    String?
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           AnalysisRunItem[]
  decisionHistories DecisionHistory[]

  @@index([userId, startedAt])
  @@index([status, startedAt])
}

model AnalysisRunItem {
  id              String   @id @default(cuid())
  runId           String
  symbol          String
  stockName       String?
  status          String   @default("running")
  decisionId      String?
  aiStatus        String?
  quoteStatus     String?
  newsStatus      String?
  errorMessage    String?
  durationMs      Int?
  aiDurationMs    Int?
  quoteDurationMs Int?
  newsDurationMs  Int?
  fallbackUsed    Boolean  @default(false)
  createdAt       DateTime @default(now())
  run             AnalysisRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([symbol, createdAt])
}

model DecisionHistory {
  id                    String   @id @default(cuid())
  userId                String
  runId                 String?
  analysisId            String?
  symbol                String
  stockName             String?
  decisionTime          DateTime @default(now())
  source                String
  strategyDirection     String
  action                String
  riskLevel             String?
  confidence            Decimal? @db.Decimal(5, 4)
  summary               String
  keyReasons            Json
  entryRange            String?
  stopLoss              String?
  takeProfit            String?
  invalidationCondition String?
  fallbackUsed          Boolean  @default(false)
  rawModelName          String?
  previousAction        String?
  previousStrategyDirection String?
  changeSummary         String?
  createdAt             DateTime @default(now())
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  run                   AnalysisRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([userId, decisionTime])
  @@index([userId, symbol, decisionTime])
  @@index([action])
  @@index([riskLevel])
}
