# 服务器部署时复制本文件为 .env，然后填写真实值。
# 不要把真实 .env 提交到 Git 仓库。

# PostgreSQL
DATABASE_URL="postgresql://stocks_user:CHANGE_ME_PASSWORD@127.0.0.1:5432/stocks_ai?schema=public"

# 行情与新闻
# A 股默认使用东方财富公开接口，不需要 key；生产稳定性更高时可替换为正式数据源。
STOCK_DATA_PROVIDER="a_share"
NEWS_PROVIDER="mock"
ALPHA_VANTAGE_API_KEY=""
FINNHUB_API_KEY=""

# AI: DeepSeek OpenAI-compatible API
OPENAI_API_KEY="CHANGE_ME_DEEPSEEK_API_KEY"
OPENAI_BASE_URL="https://api.deepseek.com"
OPENAI_MODEL="deepseek-v4-flash"

# 管理员登录
# 生成密码哈希：npm run auth:hash -- "你的强密码"
ADMIN_EMAIL="admin@stocks.local"
ADMIN_PASSWORD_HASH=""
ADMIN_PASSWORD_HASH_B64="CHANGE_ME_PASSWORD_HASH_B64"
AUTH_SECRET="CHANGE_ME_RANDOM_32_PLUS_CHARS"
AUTH_SESSION_DAYS=7

# 低配服务器限制：2 核 CPU、2GB 内存
MAX_CONCURRENT_JOBS=1
MAX_EXTERNAL_API_CONCURRENT=2
MAX_BATCH_SYMBOLS=50
IN_MEMORY_CACHE_MAX_KEYS=500
IN_MEMORY_CACHE_MAX_MB=64

# 缓存 TTL
QUOTE_CACHE_TTL_SECONDS=30
NEWS_CACHE_TTL_SECONDS=900
AI_ANALYSIS_CACHE_TTL_SECONDS=21600
LATEST_ANALYSIS_CACHE_TTL_SECONDS=300

# 后台任务
ENABLE_AUTO_ANALYSIS=false
ENABLE_BACKGROUND_WORKER=true
JOB_POLL_INTERVAL_MS=5000
JOB_TIMEOUT_SECONDS=120

# 数据保留策略
QUOTE_RETENTION_DAYS=7
NEWS_RETENTION_DAYS=90
AI_LOG_RETENTION_DAYS=90
JOB_RETENTION_DAYS=30
